/* ================================================== */
/* ASILI GEMS 2026 – PRODUCTION ENGINEERING BUILD     */
/* Version: 2.2.0 | Header: Tiffany Stack (PNG)       */
/* ================================================== */

/* 1. GLOBAL DESIGN TOKENS (Configuration Layer) */
@import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@700&family=Playfair+Display:wght@900&family=Source+Serif+4:ital,wght@0,300;0,400;0,600;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

:root {
  /* -- Primitives: Colors -- */
  --c-gold: #d4af37;
  --c-emerald: #00a67d;
  --c-white: #ffffff;
  --c-black: #000000;
  
  /* -- Semantic Aliases (The "API" of your theme) -- */
  --theme-primary: var(--nv-primary-accent, var(--c-gold));
  --theme-secondary: var(--nv-secondary-accent, var(--c-emerald));
  
  /* -- Typography Stack -- */
  --font-hero: 'Playfair Display', serif;
  --font-heading: 'DM Serif Display', serif;
  --font-body: 'Source Serif 4', Georgia, serif;
  --font-mono: 'Space Mono', monospace;
  --font-btn: 'Outfit', system-ui, sans-serif;
  
  /* -- UI Physics & Geometry -- */
  --btn-radius: 50px;
  --btn-padding-block: 1rem;       /* Top/Bottom */
  --btn-padding-inline: 2.75rem;   /* Left/Right */
  --anim-standard: 0.45s cubic-bezier(0.25, 1, 0.5, 1);
  --touch-target-min: 44px;        /* iOS Standard */
}

/* 2. TYPOGRAPHY ENGINE */

/* Hero: High specificity to override theme defaults */
.site-title a, h1, .nv-title, .hero-title, .entry-title {
  font-family: var(--font-hero) !important;
  font-weight: 900 !important;
  font-size: clamp(3.5rem, 11vw, 10rem);
  letter-spacing: -0.04em;
  line-height: 0.9;
  text-transform: uppercase;
  color: var(--theme-primary) !important;
}

/* Headings: Contrast optimized */
h2, .woocommerce-loop-category__title, .nv-page-title h1, 
.category-title h2, h2.wp-block-heading {
  font-family: var(--font-heading) !important;
  font-weight: 400 !important;
  font-size: clamp(2.6rem, 7vw, 4rem);
  letter-spacing: -0.02em;
  color: var(--c-white) !important;
}

/* Metadata: Secondary accent usage */
.count, .woocommerce-loop-product__title, h3, h4, 
.nv-meta-list, .posted_in {
  font-family: var(--font-heading);
  font-weight: 400;
  font-size: 1.125rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--theme-secondary) !important;
}

/* Body: Optimized for long-form reading */
body, p, .product-description, .entry-content, .nv-content-wrap {
  font-family: var(--font-body) !important;
  font-size: 1.1rem;
  line-height: 1.68;
}

/* Pricing: Data clarity */
.price, .woocommerce-Price-amount, .amount, .sku {
  font-family: var(--font-mono) !important;
  font-weight: 400;
  font-size: 2rem;
  letter-spacing: -0.03em;
  color: var(--theme-primary) !important;
}

/* 3. HEADER ARCHITECTURE (Tiffany Stack) */
/* Integrates Layout + PNG Logic + Menu Styles */

/* Layout: Vertical Stack on Desktop */
.header-main-inner {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    align-items: center !important;
    padding-block: 25px !important;
}

/* Logo: Centering & Sizing */
.builder-item--logo {
    width: 100% !important;
    justify-content: center !important;
    margin-bottom: 30px !important;
    margin-right: 0 !important;
}

/* PNG Logo Optimization */
.custom-logo-link img, .custom-logo {
    max-width: 300px !important; /* Luxury Width */
    width: 100% !important;
    height: auto !important;
    transition: transform 0.4s var(--anim-standard);
}
.custom-logo-link:hover img {
    transform: scale(1.02);
}

/* Navigation: Typography inheritance from Buttons */
.builder-item--primary-menu, .nav-menu-primary {
    width: 100% !important;
    justify-content: center !important;
}

.nav-menu-primary > .menu-item > a {
    font-family: var(--font-btn) !important; /* Using System Variable */
    font-weight: 700 !important;
    font-size: 13px !important;
    text-transform: uppercase !important;
    letter-spacing: 2.4px !important;
    color: var(--c-white) !important;
    transition: all 0.3s ease;
    text-decoration: none;
}

/* Navigation Interaction */
.nav-menu-primary > .menu-item > a:hover,
.nav-menu-primary > .current-menu-item > a {
    color: var(--theme-primary) !important;
    transform: translateY(-2px);
}

/* 4. INTERACTIVE COMPONENTS (Buttons) */

/* Selector Strategy: Whitelist */
.button, 
a.button, 
button[type="submit"], 
input[type="submit"],
.wp-block-button__link,
.woocommerce-button,
.add_to_cart_button,
.single_add_to_cart_button,
.checkout-button,
.nv-nav-cart a.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: var(--touch-target-min);
  
  background: transparent !important;
  color: var(--theme-primary) !important;
  border: 2px solid var(--theme-primary) !important;
  border-radius: var(--btn-radius) !important;
  
  padding-block: var(--btn-padding-block) !important;
  padding-inline: var(--btn-padding-inline) !important;
  
  font-family: var(--font-btn) !important;
  font-weight: 700 !important;
  font-size: 0.9375rem !important;
  line-height: 1;
  letter-spacing: 0.16em !important;
  text-transform: uppercase !important;
  
  will-change: transform, box-shadow;
  transition: all var(--anim-standard) !important;
}

/* Hover State */
.button:hover, a.button:hover, button[type="submit"]:hover, 
input[type="submit"]:hover, .wp-block-button__link:hover,
.woocommerce-button:hover, .add_to_cart_button:hover {
  background: var(--theme-primary) !important;
  color: var(--c-black) !important;
  transform: translateY(-0.25rem) !important;
  box-shadow: 0 1rem 2.5rem rgba(0,0,0,0.3) !important;
}

/* 5. ACCESSIBILITY */
.button:focus-visible, a.button:focus-visible {
  outline: none !important;
  box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.5) !important;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

/* 6. RESPONSIVE LOGIC */

/* Mobile: Revert Header to Row Layout */
@media (max-width: 960px) {
  .header-main-inner {
      flex-direction: row !important;
      justify-content: space-between !important;
      padding-block: 15px !important;
  }
  .builder-item--logo {
      margin-bottom: 0 !important;
      justify-content: flex-start !important;
      width: auto !important;
  }
  .custom-logo-link img, .custom-logo {
      max-width: 160px !important;
  }
}

/* Mobile: Typography Scaling */
@media (max-width: 480px) {
  :root { --btn-padding-inline: 2rem; }
  h1 { font-size: 4rem !important; }
  h2 { font-size: 2.6rem !important; }
}

/* Ultra Wide */
@media (min-width: 1921px) {
  h1 { font-size: 9.375rem !important; }
  .site-content { max-width: 1600px; margin-inline: auto; }
}
