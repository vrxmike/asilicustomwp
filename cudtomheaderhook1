<header class="header-wrapper" id="mainHeader">
    <div class="header-top">
        <div class="asili-container flex-between">
            <span class="announcement-text">Ethical Sourcing • Global Shipping</span>
            <div class="utility-links">
                <a href="/concierge">Concierge</a>
                <a href="/boutiques">Boutiques</a>
                <a href="/my-account">Account</a>
            </div>
        </div>
    </div>

    <div class="header-main">
        <div class="asili-container main-bar-layout">
            <div class="actions-group actions-left">
                <button class="mobile-toggle" onclick="toggleDrawer()" aria-label="Menu">
                    <i class="fas fa-bars"></i>
                </button>
                <button class="icon-btn desktop-only" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <button class="icon-btn desktop-only" aria-label="Wishlist">
                    <i class="far fa-heart"></i>
                </button>
            </div>

            <a href="/" class="brand-logo" id="brandLogo">
                <img src="https://www.asiligems.com/voyager/wp-content/uploads/2025/12/Asili-Gems-Ltd-01-34eee5.svg" alt="Asili Gems White" class="logo-white">
                <img src="https://www.asiligems.com/voyager/wp-content/uploads/2025/12/Asili-Gems-Ltd-Black-b3c9e8.svg" alt="Asili Gems Dark" class="logo-dark">
            </a>

            <div class="actions-group actions-right">
                <button class="mobile-toggle mobile-only" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <button class="icon-btn" aria-label="Account">
                    <i class="fas fa-user"></i>
                </button>
                <button class="icon-btn" aria-label="Cart">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="bag-count">2</span>
                </button>
            </div>
        </div>
    </div>

    <nav class="header-nav">
        <ul class="nav-list">
            <li><a href="/" class="nav-link">Home</a></li>
            <li><a href="/shop" class="nav-link">Shop</a></li>
            <li><a href="/collections" class="nav-link">Collections</a></li>
            <li><a href="/house-of-asili" class="nav-link">The House of Asili</a></li>
            <li><a href="/contact" class="nav-link">Contact</a></li>
        </ul>
    </nav>
</header>

<style>
    /* 1. LAYOUT RESET & FIXED POSITIONING */
    .header-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        z-index: 1000;
        transition: background 0.4s ease, padding 0.4s ease;
    }

    .asili-container {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .flex-between { display: flex; justify-content: space-between; align-items: center; }

    /* 2. HEADER TOP (ANNOUNCEMENT) */
    .header-top {
        padding: 8px 0;
        font-family: var(--f-ui, 'Outfit', sans-serif);
        font-size: 10px;
        letter-spacing: 1px;
        background: rgba(10, 20, 15, 0.8);
        color: rgba(255, 255, 255, 0.8);
    }
    .utility-links a { margin-left: 20px; color: inherit; text-decoration: none; }

    /* 3. MAIN BAR & LOGO SWITCHING */
    .main-bar-layout {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 20px 0;
    }

    .brand-logo img { height: 120px; width: auto; transition: all 0.3s ease; }
    
    /* Default: Not Scrolled */
    .header-wrapper:not(.scrolled) .logo-white { display: block; }
    .header-wrapper:not(.scrolled) .logo-dark { display: none; }
    .header-wrapper:not(.scrolled) .nav-link,
    .header-wrapper:not(.scrolled) .icon-btn,
    .header-wrapper:not(.scrolled) .mobile-toggle { color: #ffffff; text-shadow: 0 2px 10px rgba(0,0,0,0.3); }

    /* Scrolled State */
    .header-wrapper.scrolled { background: #ffffff; border-bottom: 1px solid rgba(0,0,0,0.05); }
    .header-wrapper.scrolled .logo-white { display: none; }
    .header-wrapper.scrolled .logo-dark { display: block; }
    .header-wrapper.scrolled .nav-link,
    .header-wrapper.scrolled .icon-btn,
    .header-wrapper.scrolled .mobile-toggle { color: #0A140F; text-shadow: none; }
    .header-wrapper.scrolled .brand-logo img { height: 80px; }

    /* 4. NAVIGATION */
    .header-nav { text-align: center; padding-bottom: 15px; }
    .nav-list { list-style: none; display: flex; justify-content: center; gap: 40px; margin: 0; padding: 0; }
    .nav-link {
        font-family: var(--f-btn, 'Outfit', sans-serif);
        font-weight: 900;
        letter-spacing: 2px;
        font-size: 14px;
        text-transform: uppercase;
        text-decoration: none;
        position: relative;
    }
    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -5px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--c-secondary, #D4AF37);
        transition: width 0.3s ease;
    }
    .nav-link:hover::after { width: 100%; }
    .nav-link:hover { color: var(--c-extra-1, #008559); }

    /* 5. MOBILE & UTILS */
    .actions-group { display: flex; align-items: center; gap: 20px; }
    .actions-right { justify-content: flex-end; }
    .icon-btn, .mobile-toggle { background: none; border: none; cursor: pointer; font-size: 1.1rem; }
    .bag-count { background: var(--c-extra-1, #008559); color: #fff; font-size: 9px; padding: 2px 5px; border-radius: 50%; vertical-align: top; margin-left: -8px; }

    @media (max-width: 768px) {
        .desktop-only { display: none; }
        .main-bar-layout { padding: 10px 0; }
        .brand-logo img { height: 60px; }
        .header-nav { display: none; }
    }
</style>

<script>
    // SHARED LOGIC FROM APP.JS
    document.addEventListener('DOMContentLoaded', function() {
        // 1. Header Scroll Effect
        window.addEventListener('scroll', () => {
            const header = document.getElementById('mainHeader');
            if (header) {
                if (window.scrollY > 20) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            }
        });

        // 2. Mobile Drawer Toggle
        // Attached to window so the HTML onclick="toggleDrawer()" can find it
        window.toggleDrawer = function() {
            const drawer = document.getElementById('mobileDrawer');
            if (drawer) {
                drawer.classList.toggle('active');
                // Lock background scroll when open
                document.body.style.overflow = drawer.classList.contains('active') ? 'hidden' : 'auto';
            }
        };
    });
</script>
